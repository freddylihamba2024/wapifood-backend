#--------------------------------------------------------------------
# WapiFood — configuration d'environnement (modèle)
#
# Copier ce fichier en `.env` et renseigner les valeurs.
# NE JAMAIS committer `.env`. Aucune valeur secrète réelle ici.
# Convention CI4 : `<classe>.<propriété>` surcharge app/Config/<Classe>.php
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONNEMENT : development | testing | production
# En production, le débogage et les traces d'erreurs sont désactivés.
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APPLICATION
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
# Les dates sont stockées en UTC ; la conversion se fait par restaurant.
app.appTimezone = 'UTC'
# true en production derrière HTTPS
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# BASE DE DONNÉES (MySQL 5.7+ / 8+, InnoDB, utf8mb4)
# 127.0.0.1 force TCP (avec « localhost », mysqli cherche /tmp/mysql.sock,
# absent sous MAMP).
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = wapifood
database.default.username =
database.default.password =
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Base dédiée aux tests automatisés : JAMAIS la base de dev ou de prod.
database.tests.hostname = 127.0.0.1
database.tests.database = wapifood_test
database.tests.username =
database.tests.password =
database.tests.DBPrefix =
database.tests.port = 3306
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# CORS — origines autorisées (séparées par des virgules, sans espace)
# Exemple : http://localhost:5173,https://app.wapifood.com
#--------------------------------------------------------------------
CORS_ALLOWED_ORIGINS = http://localhost:5173

#--------------------------------------------------------------------
# JWT — 64 caractères minimum, différent pour chaque environnement.
# Le changer invalide tous les jetons et codes OTP en cours.
# Générer : php -r "echo bin2hex(random_bytes(64)), PHP_EOL;"
#--------------------------------------------------------------------
jwt.secret =
jwt.issuer = wapifood
jwt.audience = wapifood-api
# Durées en secondes : jeton d'accès 15 min, refresh token 30 jours
jwt.accessTtl = 900
jwt.refreshTtl = 2592000

#--------------------------------------------------------------------
# AUTHENTIFICATION
#--------------------------------------------------------------------
auth.maxFailedLogins = 5
auth.lockoutMinutes = 15
auth.otpTtl = 600
auth.otpMaxAttempts = 5
auth.otpResendCooldown = 60
auth.otpMaxPerHour = 5
# Envoi des codes OTP :
#   log      (dev : code écrit dans writable/logs, refusé en production)
#   channels (canaux de notification actifs : SMS, WhatsApp, e-mail — production)
#   none     (aucun envoi : l'API répond 503)
auth.otpDelivery = log

#--------------------------------------------------------------------
# WAPIFOOD — paramètres métier
#--------------------------------------------------------------------
wapifood.defaultCurrency = USD
wapifood.defaultCommissionRate = 10.00
# Swagger UI (/docs) : true en dev, false en production
wapifood.docsEnabled = true
# Limite de requêtes par défaut sur l'API : <requêtes> par <secondes>
wapifood.rateLimitRequests = 120
wapifood.rateLimitWindow = 60

#--------------------------------------------------------------------
# UPLOADS (Phase 4) — taille en kilo-octets
#--------------------------------------------------------------------
UPLOAD_MAX_SIZE = 2048
UPLOAD_ALLOWED_TYPES = jpg,jpeg,png,webp

#--------------------------------------------------------------------
# E-MAIL (Phase 8) — canal actif quand fromEmail et SMTPHost sont renseignés
#--------------------------------------------------------------------
email.fromEmail =
email.fromName = WapiFood
email.protocol = smtp
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls

#--------------------------------------------------------------------
# SMS / WHATSAPP (Phase 8) — vide = canal désactivé
# Aucun fournisseur n'est encore choisi : seule la valeur « log » est
# reconnue (dev : message écrit dans writable/logs, refusée en production).
#--------------------------------------------------------------------
SMS_PROVIDER =
WHATSAPP_PROVIDER =

#--------------------------------------------------------------------
# NOTIFICATIONS — file d'envoi (php spark notifications:process, cron 1 min)
#--------------------------------------------------------------------
notifications.maxAttempts = 5
notifications.batchSize = 100

#--------------------------------------------------------------------
# MOBILE MONEY (Phase 6) — désactivé tant que les identifiants
# officiels et le modèle de règlement ne sont pas validés.
#--------------------------------------------------------------------
MPESA_ENABLED = false
AIRTEL_MONEY_ENABLED = false
ORANGE_MONEY_ENABLED = false

#--------------------------------------------------------------------
# JOURNALISATION : 0 = rien, 4 = jusqu'aux erreurs, 9 = tout
#--------------------------------------------------------------------
logger.threshold = 4
